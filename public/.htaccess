<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 🛡️ BLINDAGEM CONTRA ACESSO DIRETO A DADOS SENSÍVEIS E PLANILHAS (LGPD)
  # Bloqueia acesso externo e downloads diretos de arquivos de dados (Forbidden)
  RewriteCond %{REQUEST_URI} \.(xlsx|xls|csv|sql|env|bak|log)$ [NC]
  RewriteCond %{HTTP:Sec-Fetch-Site} !^same-origin$ [NC]
  RewriteRule ^ - [F,L]

  # Regras padrão de SPA (Single Page Application)
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# 🛡️ BLOQUEIO ABSOLUTO DE ARQUIVOS DE CONFIGURAÇÃO E BACKUPS
<FilesMatch "\.(env|sql|bak|log|git|sh|md|config)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# 🛡️ CABEÇALHOS DE SEGURANÇA HTTP (HARDENING OWASP)
<IfModule mod_headers.c>
  # Impede que o navegador tente adivinhar o tipo MIME (MIME-sniffing)
  Header set X-Content-Type-Options "nosniff"
  # Impede que a aplicação seja aberta em iframes externos (Anti-Clickjacking)
  Header set X-Frame-Options "SAMEORIGIN"
  # Ativa proteção nativa contra XSS refletido
  Header set X-XSS-Protection "1; mode=block"
  # Protege o cabeçalho Referer em requisições
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Desativa recursos desnecessários do navegador
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Forçar o navegador a nunca cachear o index.html (garante atualizações imediatas)
<FilesMatch "^(index\.html)?$">
  <IfModule mod_headers.c>
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
  </IfModule>
</FilesMatch>
